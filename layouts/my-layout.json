{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.13"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "my-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "my-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "my-changes"
                      }
                    },
                    {
                      "id": "graph",
                      "type": "block",
                      "content": {
                        "mod": "my-graph"
                      }
                    },
                    {
                      "id": "activity",
                      "type": "block",
                      "content": {
                        "mod": "bettr-activity",
                        "props": {
                          "verbs": {
                            "tools": {
                              "Read": "Read",
                              "Grep": "Searched",
                              "Glob": "Searched",
                              "Edit": "Edited",
                              "MultiEdit": "Edited",
                              "Write": "Edited",
                              "NotebookEdit": "Edited",
                              "WebFetch": "Fetched",
                              "WebSearch": "Searched",
                              "Agent": "Spawned",
                              "Task": "Spawned",
                              "SendMessage": "Messaged",
                              "TaskStop": "Stopped",
                              "AskUserQuestion": "Asked",
                              "Skill": "Used",
                              "ExitPlanMode": "Proposed",
                              "apply_patch": "Edited",
                              "view_image": "Read",
                              "web__run": "Searched",
                              "web_search": "Searched",
                              "spawn_agent": "Spawned",
                              "followup_task": "Messaged",
                              "interrupt_agent": "Stopped",
                              "close_agent": "Stopped",
                              "request_user_input": "Asked",
                              "request_user_input_async": "Asked",
                              "mcp__*": "Used",
                              "ToolSearch": null,
                              "ScheduleWakeup": null,
                              "ListAgents": null,
                              "TodoWrite": null,
                              "TaskOutput": null,
                              "TaskList": null,
                              "TaskGet": null,
                              "TaskCreate": null,
                              "TaskUpdate": null,
                              "Monitor": null,
                              "SendFeedback": null,
                              "CronList": null,
                              "CronCreate": null,
                              "CronDelete": null,
                              "BashOutput": null,
                              "EnterPlanMode": null,
                              "EnterWorktree": null,
                              "ExitWorktree": null,
                              "KillShell": null,
                              "ReportFindings": null,
                              "write_stdin": null,
                              "wait_agent": null,
                              "list_agents": null,
                              "send_message": null,
                              "sleep": null,
                              "update_plan": null,
                              "list_mcp_resources": null,
                              "read_mcp_resource": null,
                              "list_mcp_resource_templates": null
                            },
                            "commands": {
                              "git add": "Staged",
                              "git commit": "Committed",
                              "git pull": "Pulled",
                              "git push": "Pushed",
                              "node --test": "Tested",
                              "npm test": "Tested",
                              "pytest": "Tested",
                              "python3 -m unittest": "Tested",
                              "sleep": null
                            }
                          }
                        }
                      }
                    },
                    {
                      "id": "context",
                      "type": "column",
                      "gap": 8,
                      "children": [
                        {
                          "id": "context-main",
                          "type": "block",
                          "content": {
                            "mod": "bettr-context",
                            "props": {
                              "cache": "context-cache"
                            }
                          },
                          "size": {
                            "weight": 1
                          },
                          "min": 120
                        },
                        {
                          "id": "context-cache",
                          "type": "block",
                          "content": {
                            "mod": "bettr-context",
                            "props": {
                              "section": "cache",
                              "autoSize": "context-cache"
                            }
                          },
                          "size": {
                            "px": 37
                          },
                          "min": 37
                        }
                      ]
                    },
                    {
                      "id": "history",
                      "type": "block",
                      "content": {
                        "mod": "history"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
